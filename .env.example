NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://pitchpresence:pitchpresence@localhost:5432/pitchpresence
SESSION_SECRET=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_SECRET=replace-with-a-third-32-character-secret
QR_SIGNING_SECRET=replace-with-a-different-32-character-secret
RESEND_API_KEY=
EMAIL_FROM=PitchPresence <onboarding@example.com>
# Optional device notifications. Generate once with npm run push:setup -- mailto:you@example.com
# Keep the same keys in API and worker environments; private key is server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Manual transfer/receipt payments work without Paystack credentials.
PAYMENT_MODE=MANUAL
PAYSTACK_SECRET_KEY=
LOG_LEVEL=info

# Comma-separated trusted reverse-proxy IPs/CIDRs; empty trusts none.
TRUST_PROXY=

# Next.js uses its own process environment; export these when running dev/build.
# API_URL=http://127.0.0.1:4000
# NEXT_PUBLIC_LOCAL_MEDIA=true
# NEXT_PUBLIC_LOCAL_FONTS=true
