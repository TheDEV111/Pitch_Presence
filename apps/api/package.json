{
  "name": "@pitchpresence/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx --env-file=../../.env src/server.ts",
    "start": "node dist/server.js",
    "worker": "node --import tsx --env-file=../../.env src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "9.4.0",
    "@pitchpresence/database": "*",
    "@pitchpresence/shared": "*",
    "argon2": "0.43.1",
    "fastify": "4.29.1",
    "jose": "6.2.4",
    "web-push": "3.6.7",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  }
}
