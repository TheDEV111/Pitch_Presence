# Template only. Store the completed file OUTSIDE the repository, with permissions 600.
# Compose reads raw values: do not quote values or interpolate shell variables.
NODE_ENV=production
PORT=4000
APP_URL=https://replace-with-frontend-domain.example.com
DATABASE_URL=postgresql://postgres.PROJECT:replace-with-password@POOLER_HOST:5432/postgres?sslmode=verify-full&connection_limit=2&pool_timeout=10
SESSION_SECRET=replace-with-existing-or-new-independent-secret
DATA_ENCRYPTION_SECRET=replace-with-existing-stable-data-encryption-secret
QR_SIGNING_SECRET=replace-with-existing-or-new-independent-secret
RESEND_API_KEY=replace-with-resend-key
EMAIL_FROM=PitchPresence <replace-with-verified-sender@app.kairos-devs.com>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PAYMENT_MODE=MANUAL
PAYSTACK_SECRET_KEY=
LOG_LEVEL=info
# Compose sets the API's trusted peer for the selected reverse proxy.
TRUST_PROXY=
