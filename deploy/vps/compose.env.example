# Non-secret Compose configuration. Copy to .env.vps at the repository root.
IMAGE_TAG=replace-with-full-git-commit
BACKEND_ENV_FILE=/etc/pitchpresence/backend.env
API_DOMAIN=api.example.com
TLS_EMAIL=operator@example.com
# Choose an unused subnet; change all three values together if it overlaps a VPS network.
BACKEND_SUBNET=172.30.40.0/24
BACKEND_GATEWAY=172.30.40.1
PROXY_IPV4=172.30.40.2
