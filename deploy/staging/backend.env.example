# Copy into the NEW Coolify staging application's private variables, never production.
NODE_ENV=production
APP_ENV=staging
APP_URL=https://staging.pitch-presence.kairos-devs.com
# Supabase dashboard -> Connect -> Session pooler -> URI; percent-encode the password.
DATABASE_URL=postgresql://pitchpresence_app.STAGING_PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
STAGING_SUPABASE_PROJECT_REF=replace-with-staging-project-ref
# Reference only, not production credentials. These two references MUST differ.
PRODUCTION_SUPABASE_PROJECT_REF=replace-with-production-project-ref
STAGING_EMAIL_ALLOWLIST=tester-one@example.com,tester-two@example.com
SESSION_SECRET=replace-with-new-staging-session-secret
DATA_ENCRYPTION_SECRET=replace-with-new-staging-data-secret
QR_SIGNING_SECRET=replace-with-new-staging-qr-secret
RESEND_API_KEY=replace-with-separate-staging-resend-key
EMAIL_FROM=PitchPresence Staging <verified-sender@your-verified-domain>
PAYMENT_MODE=MANUAL
MULTI_TEAM_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
TRUST_PROXY=replace-with-actual-coolify-proxy-cidr
LOG_LEVEL=info
# Required: owner sets these AFTER inspecting spare resources, including build usage.
STAGING_API_MEMORY_LIMIT=replace-with-approved-memory-limit
STAGING_API_CPUS=replace-with-approved-cpu-limit
STAGING_WORKER_MEMORY_LIMIT=replace-with-approved-memory-limit
STAGING_WORKER_CPUS=replace-with-approved-cpu-limit
# Set to the source commit SHA for identifiable images on each deployment.
STAGING_IMAGE_TAG=replace-with-commit-sha
